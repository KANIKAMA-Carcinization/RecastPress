(module
  ;; Fixed finite WASI preview1 IO only. No EH, threads, clocks or network.
  (import "wasi_snapshot_preview1" "fd_prestat_get" (func $prestat (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_prestat_dir_name" (func $prestat_name (param i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "path_open" (func $open (param i32 i32 i32 i32 i32 i64 i64 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_readdir" (func $readdir (param i32 i32 i32 i64 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_read" (func $read (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_write" (func $write (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_close" (func $close (param i32) (result i32)))
  (import "wasi_snapshot_preview1" "path_create_directory" (func $mkdir (param i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "path_unlink_file" (func $unlink (param i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "path_rename" (func $rename (param i32 i32 i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "proc_exit" (func $exit (param i32)))
  (memory (export "memory") 2 2)
  (data (i32.const 1024) "RPFSW01\0a")
  (data (i32.const 60000) "/source/wp-includes")
  (data (i32.const 60100) "class-wpdb.php")
  (data (i32.const 60200) "rp-should-not-exist")
  (data (i32.const 60300) "X")
  (func $set (param $index i32) (param $value i32)
    (i32.store (i32.add (i32.const 1032) (i32.mul (local.get $index) (i32.const 4))) (local.get $value)))
  (func $get (param $index i32) (result i32)
    (i32.load (i32.add (i32.const 1032) (i32.mul (local.get $index) (i32.const 4)))))
  (func $read_into (param $fd i32) (param $pointer i32) (param $length i32) (result i32)
    (i32.store (i32.const 256) (local.get $pointer))
    (i32.store (i32.const 260) (local.get $length))
    (i32.store (i32.const 268) (i32.const 0))
    (call $read (local.get $fd) (i32.const 256) (i32.const 1) (i32.const 268)))
  (func (export "_start") (local $i i32) (local $errno i32) (local $n i32)
    ;; Every errno/fd begins as UINT32_MAX = not attempted.
    (loop $initialize
      (call $set (local.get $i) (i32.const -1))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $initialize (i32.lt_u (local.get $i) (i32.const 24))))
    (call $set (i32.const 1) (i32.const 0))
    (call $set (i32.const 5) (i32.const 0))
    (call $set (i32.const 9) (i32.const 0))
    (call $set (i32.const 10) (i32.const 0))
    (call $set (i32.const 12) (i32.const 0))
    (call $set (i32.const 21) (i32.const 0))
    (call $set (i32.const 22) (i32.const 0))
    (call $set (i32.const 0) (call $prestat (i32.const 3) (i32.const 0)))
    (if (i32.eqz (call $get (i32.const 0))) (then
      (local.set $n (i32.load (i32.const 4)))
      (if (i32.le_u (local.get $n) (i32.const 128)) (then
        (call $set (i32.const 22) (call $prestat_name (i32.const 3) (i32.const 2048) (local.get $n)))
        (if (i32.eqz (call $get (i32.const 22))) (then (call $set (i32.const 1) (local.get $n))))))))
    ;; Absolute guest path is resolved under the fixed runner's root preopen.
    (call $set (i32.const 2) (call $open (i32.const 3) (i32.const 0) (i32.const 60000) (i32.const 19)
      (i32.const 2) (i64.const 69689858) (i64.const 1073741823) (i32.const 0) (i32.const 272)))
    (if (i32.eqz (call $get (i32.const 2))) (then
      (call $set (i32.const 3) (i32.load (i32.const 272)))
      (i32.store (i32.const 280) (i32.const 0))
      (call $set (i32.const 4) (call $readdir (call $get (i32.const 3)) (i32.const 4096) (i32.const 32768) (i64.const 0) (i32.const 280)))
      (if (i32.eqz (call $get (i32.const 4))) (then (call $set (i32.const 5) (i32.load (i32.const 280)))))
      (call $set (i32.const 6) (call $open (call $get (i32.const 3)) (i32.const 0) (i32.const 60100) (i32.const 14)
        (i32.const 0) (i64.const 2097190) (i64.const 0) (i32.const 0) (i32.const 276)))
      (if (i32.eqz (call $get (i32.const 6))) (then
        (call $set (i32.const 7) (i32.load (i32.const 276)))
        (call $set (i32.const 8) (call $read_into (call $get (i32.const 7)) (i32.const 40000) (i32.const 32)))
        (if (i32.eqz (call $get (i32.const 8))) (then
          (call $set (i32.const 9) (i32.load (i32.const 268)))
          (call $set (i32.const 10) (i32.load (i32.const 268)))
          (block $drained
            (loop $drain
              (br_if $drained (i32.ge_u (call $get (i32.const 21)) (i32.const 64)))
              (call $set (i32.const 21) (i32.add (call $get (i32.const 21)) (i32.const 1)))
              (local.set $errno (call $read_into (call $get (i32.const 7)) (i32.const 45000) (i32.const 4096)))
              (call $set (i32.const 11) (local.get $errno))
              (br_if $drained (local.get $errno))
              (local.set $n (i32.load (i32.const 268)))
              (if (i32.eqz (local.get $n)) (then (call $set (i32.const 12) (i32.const 1)) (br $drained)))
              (call $set (i32.const 10) (i32.add (call $get (i32.const 10)) (local.get $n)))
              (br $drain)))))
        (i32.store (i32.const 288) (i32.const 60300)) (i32.store (i32.const 292) (i32.const 1))
        (call $set (i32.const 13) (call $write (call $get (i32.const 7)) (i32.const 288) (i32.const 1) (i32.const 296)))
        (call $set (i32.const 14) (call $close (call $get (i32.const 7))))
        (call $set (i32.const 15) (call $read_into (call $get (i32.const 7)) (i32.const 45000) (i32.const 1)))))
      (call $set (i32.const 16) (call $open (call $get (i32.const 3)) (i32.const 0) (i32.const 60100) (i32.const 14)
        (i32.const 0) (i64.const 64) (i64.const 0) (i32.const 0) (i32.const 276)))
      (if (i32.eqz (call $get (i32.const 16))) (then
        (call $set (i32.const 23) (call $close (i32.load (i32.const 276))))))
      (call $set (i32.const 17) (call $mkdir (call $get (i32.const 3)) (i32.const 60200) (i32.const 19)))
      (call $set (i32.const 18) (call $unlink (call $get (i32.const 3)) (i32.const 60100) (i32.const 14)))
      (call $set (i32.const 19) (call $rename (call $get (i32.const 3)) (i32.const 60100) (i32.const 14)
        (call $get (i32.const 3)) (i32.const 60200) (i32.const 19)))
      (call $set (i32.const 20) (call $close (call $get (i32.const 3))))))
    ;; One finite stdout frame: 104B header, prestat name, dirents, prefix.
    (i32.store (i32.const 512) (i32.const 1024)) (i32.store (i32.const 516) (i32.const 104))
    (i32.store (i32.const 520) (i32.const 2048)) (i32.store (i32.const 524) (call $get (i32.const 1)))
    (i32.store (i32.const 528) (i32.const 4096)) (i32.store (i32.const 532) (call $get (i32.const 5)))
    (i32.store (i32.const 536) (i32.const 40000)) (i32.store (i32.const 540) (call $get (i32.const 9)))
    (local.set $errno (call $write (i32.const 1) (i32.const 512) (i32.const 4) (i32.const 296)))
    (if (local.get $errno) (then (call $exit (i32.const 1))))
  )
)
